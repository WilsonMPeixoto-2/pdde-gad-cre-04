{
  "name": "pdde-gad-cre-04",
  "private": true,
  "version": "2.7.0",
  "description": "Guia institucional da 4ª CRE para prestação de contas do PDDE no SEI!RIO.",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "sync:pdf-manifest": "tsx scripts/sync-pdf-manifest.ts",
    "sync:brand-assets": "python scripts/generate-brand-assets.py",
    "check:content": "tsx scripts/audit-content.ts",
    "check:normative": "tsx scripts/audit-normative.ts",
    "check:pdfs": "tsx scripts/audit-pdfs.ts",
    "check:headers": "tsx scripts/audit-security-headers.ts",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "analyze:bundle": "vite build --mode analyze",
    "lighthouse": "tsx scripts/run-lighthouse.ts",
    "audit:security": "npm audit --audit-level=high",
    "audit:unused": "knip --include files,dependencies,unlisted,unresolved",
    "check:all": "npm run lint && npm run typecheck && npm run build && npm run check:bundle-budget && npm run check:headers && npm run check:content && npm run check:normative",
    "check:ci": "npm run check:all && npm run check:pdfs && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/public-sans": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "knip": "^6.29.0",
    "lighthouse": "^13.4.1",
    "pdfjs-dist": "^6.1.200",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8"
  }
}
